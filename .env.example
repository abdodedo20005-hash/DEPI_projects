# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file (it is listed in .gitignore).

# Groq (key from console.groq.com): used for the fast and the smart cloud models
GROQ_API_KEY=your-groq-key-here
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b

# Local model: the last-resort fallback (run: ollama pull qwen2.5:3b)
OLLAMA_MODEL=qwen2.5:3b

# Optional: ask for a password on the Admin page
# ADMIN_PASSWORD=choose-a-password

# Optional: policy retrieval (see "Policy answers" in the README)
# RAG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RAG_MIN_SCORE=0.30        # measure it with: python calibrate_rag.py
# RAG_TOPIC_BOOST=0.25      # 0 switches the keyword topic boost off
